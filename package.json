{
  "name": "kurio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:mocks": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node audit/prerender.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test visual.spec.ts",
    "audit:lighthouse": "node audit/run.mjs",
    "format": "prettier --write src tests audit *.json *.ts *.js *.md docs .github",
    "format:check": "prettier --check src tests audit *.json *.ts *.js *.md docs .github"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.108.4",
    "@tanstack/react-router": "1.170.46",
    "axios": "1.21.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb": "8.0.4",
    "lucide-react": "1.79.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io-client": "4.8.4",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@mswjs/socket.io-binding": "0.2.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.7",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "chrome-launcher": "1.2.3",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "lighthouse": "13.6.0",
    "msw": "2.15.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
